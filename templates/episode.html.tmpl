{{- /* episode.html.tmpl — one episode page. Dot is a render.Page with .Episode
       set and .Prev/.Next adjacent episodes (either may be nil). The
       PodcastEpisode JSON-LD is emitted by base.html.tmpl via .JSONLD. */ -}}
{{define "content"}}
<article>
<h1>#{{.Episode.Number}} — {{.Episode.Title}}</h1>
<p class="meta">{{rfc2822 .Episode.PubDate}} · {{durationHMS .Episode.AudioDur}}</p>
<audio controls preload="none" src="/{{.Episode.MP3Path}}"></audio>
<a class="download" href="/{{.Episode.MP3Path}}" download>Download MP3</a>
<video controls preload="metadata" src="/{{.Episode.MP4Path}}"></video>
<div class="show-notes">{{safeHTML .Episode.Description}}</div>
{{- if or .Prev .Next}}
<nav class="episode-nav">
{{- if .Prev}}
<a class="prev" rel="prev" href="/{{.Prev.PagePath}}">‹ #{{.Prev.Number}} {{.Prev.Title}}</a>
{{- end}}
{{- if .Next}}
<a class="next" rel="next" href="/{{.Next.PagePath}}">#{{.Next.Number}} {{.Next.Title}} ›</a>
{{- end}}
</nav>
{{- end}}
</article>
{{end}}

# Tech.Go deployment secrets/config. Copy this file to .env and fill in the
# values. .env is gitignored. Only `techgo deploy` reads it.
#
# Comments must be on their own line (the parser does not strip trailing `# ...`).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional — only for STS / assumed-role / IAM Identity Center credentials.
AWS_SESSION_TOKEN=

# The S3 bucket's region. (The CloudFront API is always signed in us-east-1.)
AWS_REGION=us-east-1

S3_BUCKET=techgo-site

# Optional — deploy under a key prefix instead of the bucket root.
# If set, the CloudFront distribution's origin path must be /<prefix>.
S3_PREFIX=

CLOUDFRONT_DISTRIBUTION_ID=

# Optional — override the AWS endpoints. Leave these empty for normal AWS use;
# set them to point `techgo deploy` at LocalStack, MinIO, or another emulator
# (matches the AWS SDK convention).
AWS_ENDPOINT_URL_S3=
AWS_ENDPOINT_URL_CLOUDFRONT=
